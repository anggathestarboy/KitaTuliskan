APP_DEBUG=true
APP_URL=http://localhost:8000
ADDR=:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=draftcms_lite
DB_USERNAME=root
DB_PASSWORD=

MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=hello@example.com

CMS_ROUTE=admin-panel
# opt-in: jalankan `make activity_log` untuk menyalakan
ACTIVITY_LOG_ENABLED=false

# Media Library: konversi WebP otomatis + slider kompresi (padanan config/media.php)
MEDIA_CONVERT_TO_WEBP=true
MEDIA_WEBP_MIN_SIZE_KB=200
MEDIA_WEBP_MAX_SIZE_KB=800
MEDIA_WEBP_MAX_QUALITY=90
MEDIA_WEBP_MIN_QUALITY=40
MEDIA_WEBP_MIN_DIMENSION=320
SITE_URL=http://localhost:4321
