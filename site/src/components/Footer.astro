---
const items: any[] = (navigation.footer?.menu_loop ?? []);
---

<footer class="flex flex-wrap justify-between gap-4 border-t border-gray-200 p-6 text-sm text-gray-500">
   <span>© {new Date().getFullYear()} {global.site_settings?.site_name ?? site?.name}</span>
   <nav class="flex gap-4">
      {items.map((i) => <a href={i.menu_url || '#'}>{i.menu_label}</a>)}
      {sites.length > 1 && sites.map((s) => <a href={new URL(s.url || '/', 'http://x').pathname}>{s.name}</a>)}
   </nav>
</footer>
