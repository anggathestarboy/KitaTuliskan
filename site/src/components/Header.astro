---
// Menu dari blueprint navigations.header: field replicator menu_loop (menu_label, menu_url).
const items: any[] = (navigation.header?.menu_loop ?? []);
---

<header class="flex items-center justify-between border-b border-gray-200 px-6 py-4">
   <a href="/" class="font-bold">{global.site_settings?.site_name ?? site?.name}</a>
   <nav class="flex gap-4">
      {items.map((i) => <a href={i.menu_url || '#'}>{i.menu_label}</a>)}
   </nav>
</header>
