---
import { formAction } from '../../../cms';

const sent = Astro.url.searchParams.has('sent');
---

<!-- Section: Contact (HTML statis, Tailwind v4 + utility dari CSS kamu) -->
<section aria-labelledby="contact-title" class="container py-8 md:py-12">
  <div class="grid gap-y-10 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] lg:gap-x-16 lg:gap-y-10">
    <!-- Header (kolom kiri, baris 1) -->
    <header class="max-w-[60ch] lg:col-start-1 lg:row-start-1">
      <h2 id="contact-title" class="heading-56 md:heading-64 text-neutral-950">
        {data.overview_heading}
      </h2>
      <p class="paragraph-16 md:paragraph-18 mt-4 text-neutral-600">
        {data.overview_desc}
      </p>
    </header>

    <!-- Form (kolom kiri, baris 2) -->
    <form
      action={formAction('form_contact')}
      method="post"
      class="min-w-0 max-w-[640px] lg:col-start-1 lg:row-start-2"
    >
      <!-- Halaman tujuan setelah pesan terkirim -->
      <input type="hidden" name="_redirect" value={`${Astro.url.origin}${Astro.url.pathname}?sent=1`} />

      {sent && (
        <p role="status" class="paragraph-14 mb-5 border border-green-600 bg-green-50 px-3 py-2.5 text-green-800">
          Pesan berhasil dikirim. Terima kasih!
        </p>
      )}

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label
            for="contact-name"
            class="paragraph-12-semibold text-neutral-950"
          >
            Name
          </label>
          <input
            id="contact-name"
            name="contact_name"
            type="text"
            required
            autocomplete="name"
            placeholder="Clara Lindqvist"
            class="paragraph-14 mt-2 block w-full border border-neutral-300 bg-white px-3 py-2.5 text-neutral-900 placeholder:text-neutral-500 focus-visible:border-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
          />
        </div>
        <div>
          <label
            for="contact-email"
            class="paragraph-12-semibold text-neutral-950"
          >
            Email
          </label>
          <input
            id="contact-email"
            name="contact_email"
            type="email"
            required
            autocomplete="email"
            placeholder="clara@domain.com"
            class="paragraph-14 mt-2 block w-full border border-neutral-300 bg-white px-3 py-2.5 text-neutral-900 placeholder:text-neutral-500 focus-visible:border-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
          />
        </div>
      </div>

      <div class="mt-5">
        <label
          for="contact-subject"
          class="paragraph-12-semibold text-neutral-950"
        >
          Subject
        </label>
        <input
          id="contact-subject"
          name="contact_subject"
          type="text"
          required
          placeholder="Note on civic architecture"
          class="paragraph-14 mt-2 block w-full border border-neutral-300 bg-white px-3 py-2.5 text-neutral-900 placeholder:text-neutral-500 focus-visible:border-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
        />
      </div>

      <div class="mt-5">
        <label
          for="contact-message"
          class="paragraph-12-semibold text-neutral-950"
        >
          Message
        </label>
        <textarea
          id="contact-message"
          name="contact_message"
          required
          rows="6"
          placeholder="Write your message here..."
          class="paragraph-14 mt-2 block w-full resize-y border border-neutral-300 bg-white px-3 py-2.5 text-neutral-900 placeholder:text-neutral-500 focus-visible:border-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
        ></textarea>
      </div>

      <button
        type="submit"
        class="paragraph-12-semibold mt-6 bg-neutral-950 px-8 py-4 text-white transition-colors hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900"
      >
        Send message
      </button>
    </form>

    <!-- Info -->
    <!-- Info (kolom kanan, baris 2 — sejajar dengan atas form) -->
    <aside class="min-w-0 border-t border-neutral-200 pt-5 lg:col-start-2 lg:row-start-2 lg:self-start">
      <div>
        <h3 class="font-paragraph paragraph-12-medium uppercase tracking-[0.08em] text-neutral-600">
          Direct email
        </h3>
        <a
          href="mailto:rizqianggaradev@gmail.com"
          class="paragraph-16 mt-3 inline-block text-neutral-950 underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900"
        >
          rizqianggaradev@gmail.com
        </a>
      </div>

      <div class="mt-6">
        <h3 class="font-paragraph paragraph-12-medium uppercase tracking-[0.08em] text-neutral-600">
          Elsewhere
        </h3>
        <ul class="paragraph-14 mt-3 space-y-3 text-neutral-900">
          {data?.social_media_loop?.map((item) => (
            <li>
              <a
                href={item.social_media_link}
                class="underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900"
              >
                {item.social_media}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
</section>
