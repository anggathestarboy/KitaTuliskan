<main style="max-width:40rem;margin:4rem auto;padding:0 1rem">
   <h1>{data.title}</h1>
   {data.about_page}
   {data.subheading && <p>{data.subheading}</p>}
   <div set:html={data.content} />

   {data.hero_text}
   {data.hero_image?.alt}

   {global.global_sidebar?.site_image && (
      <img src={global.global_sidebar.site_image.url} alt={global.global_sidebar.site_image.alt} width={global.global_sidebar.site_image.width} height={global.global_sidebar.site_image.height} loading={global.global_sidebar.site_image.loading} />
   )}

   <h2>global.global_sidebar.menu_loop</h2>
   <ul>
      {global.global_sidebar?.menu_loop?.filter((m: any) => m._enabled).map((menu: any) => (
         <li>
            {menu.menu_label}
            <ul>{menu.menu_child_menu?.filter((c: any) => c._enabled).map((child: any) => <li>{child.menu_child_label}</li>)}</ul>
         </li>
      ))}
   </ul>

