<section class="container py-16">
  {collection.blog?.slice(0, 1).map((post) => (
    <a href={post.url} class="block">
      <h2 class="heading-48">{post.title}</h2>
    </a>
  ))}
</section>

<section class="container py-16 grid gap-6 md:grid-cols-3">
  {collection.blog?.slice(1, 4).map((post) => (
    <a href={post.url} class="block">
      <h3 class="heading-24">{post.title}</h3>
    </a>
  ))}
</section>

<!-- Section: Latest articles (HTML statis, Tailwind v4 + utility dari CSS kamu) -->
<section aria-labelledby="latest-articles" class="container py-8 md:py-12">
  <!-- Header -->
  <div class="flex items-center justify-between border-b border-neutral-200 pb-3">
    <h2
      id="latest-articles"
      class="font-paragraph paragraph-12-semibold uppercase tracking-[0.08em] text-neutral-900"
    >
      Latest articles
    </h2>
    <a
      href="#"
      class="paragraph-14-medium text-neutral-900 underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900"
    >
      All essays &rarr;
    </a>
  </div>

  <!-- Grid: 1 kolom di mobile/tablet, 2 kolom di desktop -->
  <div class="mt-6 grid gap-10 md:mt-8 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:gap-0">
    <!-- Featured -->
    {collection.blog?.slice(0, 1).map((item) => (
      <>
        <article class="group lg:pr-[30px]">
          <a
            href="#"
            class="block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900"
          >
            <div class="aspect-[8/5] overflow-hidden bg-neutral-200">
              <img
                src="http://localhost:8000/storage/assets/e6d347943f8bc97c762bd94d1fe74404.webp"
                alt="Brutalist civic library with unfinished concrete facade"
                width="1216"
                height="760"
                loading="lazy"
                class="h-full w-full object-cover"
              />
            </div>
            <p class="paragraph-12-medium mt-4 uppercase tracking-[0.08em] text-neutral-600">
             {item.selected_news_taxonomy?.title}
            </p>
            <h3 class="heading-36 md:heading-44 mt-3 max-w-[18ch] text-neutral-950 decoration-1 underline-offset-4 group-hover:underline">
              Notes on Unfinished Concrete and Civic Permanence
            </h3>
            <p class="paragraph-16 md:paragraph-18 mt-4 max-w-[60ch] text-neutral-600">
              Why post-war municipal libraries age with more dignity than
              contemporary glass pavilions, and what public buildings owe to the
              passage of time.
            </p>
            <p class="paragraph-12-medium mt-6 text-neutral-600">
              <time>Nov 18, 2026</time>
              <span aria-hidden="true" class="mx-2">
                &middot;
              </span>
              <span>7 min read</span>
            </p>
          </a>
        </article>
      </>
    ))}

    <!-- Side list -->
    <div class="flex flex-col lg:justify-between lg:border-l lg:border-neutral-200 lg:pl-[30px]">
      <!-- Item 1 -->
      <article class="group border-b border-neutral-200 py-6 first:pt-0 lg:py-0 lg:pb-8">
        <a
          href="#"
          class="grid grid-cols-[112px_minmax(0,1fr)] items-start gap-4 sm:grid-cols-[200px_minmax(0,1fr)] sm:gap-6 lg:grid-cols-[178px_minmax(0,1fr)] lg:gap-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900"
        >
          <div class="aspect-[4/3] overflow-hidden bg-neutral-200">
            <img
              src="/images/articles/open-book.jpg"
              alt="Open book on a desk beside letterpress type"
              width="400"
              height="300"
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </div>
          <div class="min-w-0">
            <p class="paragraph-12-medium uppercase tracking-[0.08em] text-neutral-600">
              Typography
            </p>
            <h3 class="heading-18 sm:heading-24 lg:heading-20 mt-1.5 text-neutral-950 decoration-1 underline-offset-4 group-hover:underline">
              Against Decorative Grids in Digital Reading
            </h3>
            <p class="paragraph-14 mt-2 hidden text-neutral-600 sm:block">
              How generous margins and quiet hierarchy restore attention to
              long-form prose.
            </p>
            <p class="paragraph-12-medium mt-2 text-neutral-600 sm:mt-3">
              <time>Nov 11, 2026</time>
              <span aria-hidden="true" class="mx-2">
                &middot;
              </span>
              <span>5 min read</span>
            </p>
          </div>
        </a>
      </article>

      <!-- Item 2 -->
      <article class="group border-b border-neutral-200 py-6 lg:py-0 lg:pb-8">
        <a
          href="#"
          class="grid grid-cols-[112px_minmax(0,1fr)] items-start gap-4 sm:grid-cols-[200px_minmax(0,1fr)] sm:gap-6 lg:grid-cols-[178px_minmax(0,1fr)] lg:gap-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900"
        >
          <div class="aspect-[4/3] overflow-hidden bg-neutral-200">
            <img
              src="/images/articles/library-room.jpg"
              alt="Person reading at a table in a room lined with bookshelves"
              width="400"
              height="300"
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </div>
          <div class="min-w-0">
            <p class="paragraph-12-medium uppercase tracking-[0.08em] text-neutral-600">
              Editorial
            </p>
            <h3 class="heading-18 sm:heading-24 lg:heading-20 mt-1.5 text-neutral-950 decoration-1 underline-offset-4 group-hover:underline">
              On Building a Personal Library of Monographs
            </h3>
            <p class="paragraph-14 mt-2 hidden text-neutral-600 sm:block">
              Why physical reference books still anchor how we think about
              proportion and permanence.
            </p>
            <p class="paragraph-12-medium mt-2 text-neutral-600 sm:mt-3">
              <time>Nov 08, 2026</time>
              <span aria-hidden="true" class="mx-2">
                &middot;
              </span>
              <span>5 min read</span>
            </p>
          </div>
        </a>
      </article>

      <!-- Item 3 -->
      <article class="group pt-6 lg:pt-0">
        <a
          href="#"
          class="grid grid-cols-[112px_minmax(0,1fr)] items-start gap-4 sm:grid-cols-[200px_minmax(0,1fr)] sm:gap-6 lg:grid-cols-[178px_minmax(0,1fr)] lg:gap-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900"
        >
          <div class="aspect-[4/3] overflow-hidden bg-neutral-200">
            <img
              src="/images/articles/window-desk.jpg"
              alt="Wooden desk by a large window with black frame"
              width="400"
              height="300"
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </div>
          <div class="min-w-0">
            <p class="paragraph-12-medium uppercase tracking-[0.08em] text-neutral-600">
              Craft &amp; Tools
            </p>
            <h3 class="heading-18 sm:heading-24 lg:heading-20 mt-1.5 text-neutral-950 decoration-1 underline-offset-4 group-hover:underline">
              The Case for Plain Text Archives
            </h3>
            <p class="paragraph-14 mt-2 hidden text-neutral-600 sm:block">
              Keeping twenty years of notebooks legible without proprietary
              formats or cloud lock-in.
            </p>
            <p class="paragraph-12-medium mt-2 text-neutral-600 sm:mt-3">
              <time>Nov 04, 2026</time>
              <span aria-hidden="true" class="mx-2">
                &middot;
              </span>
              <span>6 min read</span>
            </p>
          </div>
        </a>
      </article>
    </div>
  </div>
</section>
