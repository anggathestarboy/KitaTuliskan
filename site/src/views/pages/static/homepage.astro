<!-- Section: Latest articles (HTML statis, Tailwind v4 + utility dari CSS kamu) -->
<section aria-labelledby="latest-articles" class="container py-8 md:py-12">
  <!-- Header -->
  <div class="flex items-center justify-between pb-3">
    <h2
      id="latest-articles"
      class="font-paragraph paragraph-12-semibold uppercase tracking-[0.08em] text-neutral-900"
    >
      Latest articles
    </h2>
    <a
      href="#"
      class="paragraph-14-medium text-neutral-900 underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900"
    >
      All essays &rarr;
    </a>
  </div>

  <!-- Grid: 1 kolom di mobile/tablet, 2 kolom di desktop -->
  <div class="mt-6 grid gap-10 md:mt-8 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:gap-0">
    <!-- Featured -->
    {collection.blog?.slice(0, 1).map((item) => (
      <>
        <article class="group lg:pr-[30px]">
          <a
            href={item.url}
            class="block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900"
          >
            <div class="aspect-[8/5] overflow-hidden bg-neutral-200">
              <img
                src={item.meta_featured_image.url}
                alt="Brutalist civic library with unfinished concrete facade"
                width="1216"
                height="760"
                loading="lazy"
                class="h-full w-full object-cover"
              />
            </div>
            <p class="paragraph-12-medium mt-4 uppercase tracking-[0.08em] text-neutral-600">
              {item.selected_news_taxonomy?.title}
            </p>
            <h3 class="heading-36 md:heading-44 mt-3 text-neutral-950 decoration-1 underline-offset-4 group-hover:underline">
              {item.title}
            </h3>
            <div
              class="paragraph-16 md:paragraph-18 mt-4 max-w-[60ch] text-neutral-600 line-clamp-2"
              set:html={item.news_content?.replace(/<[^>]*>/g, " ")}
            />
            <p class="paragraph-12-medium mt-6 text-neutral-600">
              <time>
                {new Date(item.date).toLocaleDateString("en-US", {
                  month: "long",
                  day: "numeric",
                  year: "numeric",
                })}
              </time>
              <span aria-hidden="true" class="mx-2">
                &middot;
              </span>
              <span>{item.meta_author}</span>
            </p>
          </a>
        </article>
      </>
    ))}

    <!-- Side list -->
    <div class="flex flex-col lg:justify-between lg:pl-[30px]">
      {collection.blog?.slice(1, 4).map((item) => (
        <>
          <article class="group py-6 first:pt-0 lg:py-0 lg:pb-8">
            <a
              href={item.url}
              class="grid grid-cols-[112px_minmax(0,1fr)] items-start gap-4 sm:grid-cols-[200px_minmax(0,1fr)] sm:gap-6 lg:grid-cols-[178px_minmax(0,1fr)] lg:gap-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900"
            >
              <div class="aspect-[4/3] overflow-hidden bg-neutral-200">
                <img
                  src={item.meta_featured_image?.url}
                  alt="Open book on a desk beside letterpress type"
                  width="400"
                  height="300"
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
              </div>
              <div class="min-w-0">
                <p class="paragraph-12-medium uppercase tracking-[0.08em] text-neutral-600">
                  {item.selected_news_taxonomy.title}
                </p>
                <h3 class="heading-18 sm:heading-24 lg:heading-20 mt-1.5 text-neutral-950 decoration-1 underline-offset-4 group-hover:underline">
                  {item.title}
                </h3>
                <div class="paragraph-14 mt-2 hidden text-neutral-600 sm:line-clamp-2">
                  {item.news_content?.replace(/<[^>]*>/g, " ")}
                </div>

                <p class="paragraph-12-medium mt-2 text-neutral-600 sm:mt-3">
                  <time>Nov 11, 2026</time>
                  <span aria-hidden="true" class="mx-2">
                    &middot;
                  </span>
                  <span>5 min read</span>
                </p>
              </div>
            </a>
          </article>
        </>
      ))}
    </div>
  </div>
</section>

<section aria-label="Related articles" class="container py-8 md:py-12">
  <div class="grid gap-0 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)_minmax(0,1fr)]">
    <!-- Card 1: gambar 8/5 -->
    {data.skill_loop.slice(0, 1).map((item) => (
      <>
        <article class="group py-6 first:pt-0 lg:py-0 lg:pr-[30px]">
          <a class="block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900">
            <div class="aspect-[16/9] overflow-hidden bg-neutral-200">
              <img
                src={item.skill_image.url}
                alt="Minimalist gallery interior with single wooden bench"
                width="1200"
                height="675"
                loading="lazy"
                class="h-full w-full object-cover grayscale"
              />
            </div>
            <p class="paragraph-12-medium mt-4 uppercase tracking-[0.08em] text-neutral-600"></p>
            <h3 class="heading-28 mt-2 text-neutral-950 decoration-1 underline-offset-4">
              {item.skill_title}
            </h3>
            <p class="paragraph-16 mt-3 max-w-[60ch] text-neutral-600">
              {item.skill_desc}
            </p>
            <p class="paragraph-12-medium mt-4 text-neutral-600"></p>
          </a>
        </article>
      </>
    ))}

    {data?.skill_loop.slice(1, 2).map((item) => (
      <>
        <article class="group border-t border-neutral-200 py-6 lg:border-t-0 lg:border-l lg:px-[30px] lg:py-0">
          <a class="block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900">
            <div class="aspect-[4/3] overflow-hidden bg-neutral-200">
              <img
                src={item.skill_image.url}
                alt="Vintage rangefinder camera resting on linen beside a window"
                width="1000"
                height="750"
                loading="lazy"
                class="h-full w-full object-cover grayscale"
              />
            </div>
            <p class="paragraph-12-medium mt-4 uppercase tracking-[0.08em] text-neutral-600"></p>
            <h3 class="heading-28 mt-2 text-neutral-950 decoration-1 underline-offset-4">
              {item.skill_title}
            </h3>
            <p class="paragraph-16 mt-3 max-w-[60ch] text-neutral-600">
              {item.skill_desc}
            </p>
            <p class="paragraph-12-medium mt-4 text-neutral-600"></p>
          </a>
        </article>
      </>
    ))}
    <!-- Card 2: gambar 4/3 -->

    {data?.skill_loop?.slice(2, 3).map((item) => (
      <>
        <article class="group flex flex-col justify-between border-t border-neutral-200 py-6 lg:border-t-0 lg:border-l lg:py-0 lg:pl-[30px]">
          <a class="block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900">
            <p class="paragraph-12-medium uppercase tracking-[0.08em] text-neutral-600"></p>
            <h3 class="heading-36 mt-2 text-neutral-950 decoration-1 underline-offset-4">
              {item.skill_title}
            </h3>
            <p class="paragraph-16 mt-4 max-w-[40ch] text-neutral-600">
              {item.skill_desc}
            </p>
            <p class="paragraph-12-medium mt-6 text-neutral-600"></p>
          </a>
          <p class="paragraph-12-medium mt-10 border-t border-neutral-200 pt-5 text-neutral-950 lg:mt-0">
            By {item.author_name}
          </p>
        </article>
      </>
    ))}
    <!-- Card 3: teks saja, penulis di bawah -->
  </div>
</section>

<section aria-label="More articles" class="container py-8 md:py-12">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1fr)] lg:gap-x-10">
    <!-- Featured (gambar portrait) -->
    <article class="group">
      <a
        href="#"
        class="block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900"
      >
        <div class="aspect-[3/4] overflow-hidden bg-neutral-200">
          <img
            src={data.profile_image.url}
            alt="Narrow cobblestone alley in the rain with a lone figure holding an umbrella"
            width="900"
            height="1200"
            loading="lazy"
            class="h-full w-full object-cover grayscale"
          />
        </div>
        <p class="paragraph-12-medium mt-4 uppercase tracking-[0.08em] text-neutral-600"></p>
        <h3 class="heading-28 mt-2 text-neutral-950 decoration-1 underline-offset-4 group-hover:underline">
          {data.profile_name}
        </h3>
        <p class="paragraph-14 mt-3 max-w-[60ch] text-neutral-600">
          {data.profile_desc}
        </p>
        <p class="paragraph-12-medium mt-4 text-neutral-600"></p>
      </a>
    </article>
    <!-- List teks -->
    <div class="flex flex-col">
      <article class="group border-t border-neutral-200 py-6 first:pt-6 lg:pt-9">
        <a
          href="#"
          class="block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900"
        >
          <div class="flex items-baseline justify-between gap-4">
            <p class="paragraph-12-medium uppercase tracking-[0.08em] text-neutral-600">
              Typography
            </p>
            <p class="paragraph-12-medium shrink-0 text-neutral-600"></p>
          </div>
          <h3 class="heading-40 mt-3 max-w-[22ch] text-neutral-950 decoration-1 underline-offset-4 group-hover:underline">
            Proportion Before Ornament: Lessons from Swiss Bookmaking
          </h3>
          <p class="paragraph-16 mt-3 max-w-[60ch] text-neutral-600">
            When a page relies solely on paper, ink, and measure, every
            typographic decision becomes structural rather than cosmetic.
          </p>
        </a>
      </article>
      <article class="group border-t border-b border-neutral-200 py-6 lg:pt-9">
        <a
          href="#"
          class="block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900"
        >
          <div class="flex items-baseline justify-between gap-4">
            <p class="paragraph-12-medium uppercase tracking-[0.08em] text-neutral-600">
              Digital Culture
            </p>
            <p class="paragraph-12-medium shrink-0 text-neutral-600"></p>
          </div>
          <h3 class="heading-40 mt-3 text-neutral-950 decoration-1 underline-offset-4 group-hover:underline">
            Designing Interfaces That Know When to Step Back
          </h3>
          <p class="paragraph-16 mt-3 max-w-[60ch] text-neutral-600">
            Why the most respectful software feels closer to a well-bound
            reference volume than an entertainment feed.
          </p>
        </a>
      </article>
    </div>
  </div>
</section>
