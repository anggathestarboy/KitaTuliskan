---
// = <x-layouts::site.layout>: membungkus tiap halaman. Title: SEO entry → heading/title → nama site.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { json } from '../cms';
const { site, data, entry, global } = Astro.locals;
const title = json(entry.seo).meta_title || data.heading || data.title || global.site_settings?.site_name || site?.name || 'Draft CMS Lite';
---

<html lang={site?.lang ?? 'en'}>
   <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width" />
      <title>{title}</title>
   </head>
   <body style="font-family:system-ui;margin:0;display:flex;flex-direction:column;min-height:100vh">
      <Header />
      <div style="flex:1"><slot /></div>
      <Footer />
   </body>
</html>
