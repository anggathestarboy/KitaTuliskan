---
// = <x-layouts::site.layout>: membungkus tiap halaman. Title: SEO entry → heading/title → nama site.
// Live preview (pages/preview/[token].astro) mengisi previewVersion → PreviewBar (status + polling + toggle device) ikut dirender.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PreviewBar from '../components/PreviewBar.astro';
import { json } from '../cms';
import '../styles/global.css';
const { previewVersion } = Astro.locals;
const title = json(entry.seo).meta_title || data.heading || data.title || global.site_settings?.site_name || site?.name || 'Draft CMS Lite';
---

<html lang={site?.lang ?? 'en'}>
   <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width" />
      <title>{title}</title>
      <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
   </head>
   <body class="m-0">
      <div id="cms-preview-frame" class="flex min-h-screen flex-col overflow-x-hidden">
         <Header />
         <main class="flex-1"><slot /></main>
         <Footer />
      </div>
      {previewVersion !== undefined && <PreviewBar />}
   </body>
</html>
