---
// = <x-layouts::site.layout :title :site>
const { title = 'Draft CMS Lite', site } = Astro.props;
---

<html lang={site?.lang ?? 'en'}>
   <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width" />
      <title>{title}</title>
   </head>
   <body style="font-family:system-ui;margin:0">
      <slot />
   </body>
</html>
